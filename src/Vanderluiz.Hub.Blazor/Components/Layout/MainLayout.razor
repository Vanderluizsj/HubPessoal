@inherits LayoutComponentBase
@inject AdminStateService AdminState
@implements IDisposable

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="admin-header">
            <div class="d-flex align-items-center gap-2">
                @if (AdminState.EstaAutenticado)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 d-flex align-items-center gap-1">
                        <i class="bi bi-shield-check"></i> Modo Administrador
                    </span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 d-flex align-items-center gap-1">
                        <i class="bi bi-eye"></i> Modo Leitura (Portfólio)
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-3">
                @if (AdminState.EstaAutenticado)
                {
                    <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" @onclick="AdminState.Sair">
                        <i class="bi bi-box-arrow-right"></i> Sair do Admin
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-hub d-flex align-items-center gap-1" @onclick="() => exibirLoginModal = true">
                        <i class="bi bi-key-fill"></i> Acesso Admin
                    </button>
                }
            </div>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<AdminLoginModal @bind-Exibir="exibirLoginModal" />

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool exibirLoginModal = false;

    protected override void OnInitialized()
    {
        AdminState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AdminState.OnChange -= StateHasChanged;
    }
}
