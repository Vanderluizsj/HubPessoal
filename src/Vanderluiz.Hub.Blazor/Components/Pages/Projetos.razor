@page "/admin/projetos"
@inject HubApiClient Api
@inject AdminStateService AdminState
@implements IDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Vanderluiz.Hub.Application.DTOs
@using Vanderluiz.Hub.Domain.Enums
@using Vanderluiz.Hub.Blazor.Components.Shared

<PageTitle>Projetos · Hub Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Gerenciar Projetos</h1>
        <p class="texto-suave mb-0">Cadastre, edite ou exclua projetos exibidos no portfólio público.</p>
    </div>
    <button class="btn btn-hub d-flex align-items-center gap-2" @onclick="TentarCriarProjeto">
        <i class="bi bi-plus-lg"></i> Novo Projeto
    </button>
</div>

@if (!AdminState.EstaAutenticado)
{
    <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <i class="bi bi-info-circle me-1"></i>
            Você está no <strong>Modo Leitura (Portfólio)</strong>. Ao clicar em criar, editar ou excluir, será solicitada a chave de Administrador.
        </div>
        <button class="btn btn-sm btn-outline-info" @onclick="() => exibirLoginModal = true">Ativar Admin</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensagemAlerta))
{
    <div class="alert alert-@(tipoAlerta) alert-dismissible fade show" role="alert">
        @mensagemAlerta
        <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
    </div>
}

<!-- FILTRO DE BUSCA -->
<div class="hub-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-secondary">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control border-start-0"
                       placeholder="Filtrar por título, resumo ou tecnologia..."
                       @bind="termoBusca" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-6 text-md-end texto-suave small">
            Exibindo <strong>@ProjetosFiltrados.Count()</strong> de <strong>@projetos.Count</strong> projeto(s)
        </div>
    </div>
</div>

@if (carregando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="texto-suave mt-2">Carregando projetos...</p>
    </div>
}
else
{
    var lista = ProjetosFiltrados.ToList();
    @if (lista.Count == 0)
    {
        <div class="hub-card p-5 text-center">
            <i class="bi bi-folder-x fs-1 texto-suave"></i>
            <p class="mt-2 mb-0 texto-suave">Nenhum projeto encontrado.</p>
        </div>
    }
    else
    {
        <div class="hub-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 72px;">Prévia</th>
                            <th>Título</th>
                            <th>Status</th>
                            <th>Destaque</th>
                            <th>Tecnologias</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in lista)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.ImagemUrl))
                                    {
                                        <img src="@p.ImagemUrl" alt="@p.Titulo"
                                             class="rounded border border-secondary"
                                             style="width: 56px; height: 38px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-info"
                                             style="width: 56px; height: 38px;">
                                            <i class="bi bi-code-slash"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@p.Titulo</div>
                                    <div class="small texto-suave text-truncate" style="max-width: 340px;">@p.Resumo</div>
                                </td>
                                <td>
                                    <span class="status-badge @ObterCssStatus(p.Status)">@p.Status</span>
                                </td>
                                <td>
                                    @if (p.Destaque)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Sim</span>
                                    }
                                    else
                                    {
                                        <span class="texto-suave small">Não</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var t in p.Tecnologias.Take(4))
                                        {
                                            <span class="tec-chip">@t.Nome</span>
                                        }
                                        @if (p.Tecnologias.Count > 4)
                                        {
                                            <span class="tec-chip">+@(p.Tecnologias.Count - 4)</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-hub-outline" title="Editar" @onclick="() => TentarEditar(p.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Excluir" @onclick="() => TentarExcluir(p)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- MODAL DE CADASTRO / EDIÇÃO -->
@if (exibirModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(projetoEdicaoId.HasValue ? "Editar Projeto" : "Novo Projeto")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="inputModel" OnValidSubmit="SalvarProjetoAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Título *</label>
                                <InputText class="form-control" @bind-Value="inputModel.Titulo" placeholder="Ex: Gestão de Equipamentos" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Slug (opcional)</label>
                                <InputText class="form-control" @bind-Value="inputModel.Slug" placeholder="auto-gerado" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Resumo *</label>
                                <InputText class="form-control" @bind-Value="inputModel.Resumo" placeholder="Breve frase de destaque" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Descrição Completa *</label>
                                <InputTextArea class="form-control" rows="4" @bind-Value="inputModel.Descricao" placeholder="Explique sobre o projeto, tecnologias e desafios enfrentados..." required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">URL do Repositório</label>
                                <InputText class="form-control" @bind-Value="inputModel.UrlRepositorio" placeholder="https://github.com/..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">URL da Demonstração</label>
                                <InputText class="form-control" @bind-Value="inputModel.UrlDemo" placeholder="https://..." />
                            </div>

                            <!-- UPLOAD DE PRÉVIA (GIF / IMAGEM) -->
                            <div class="col-12">
                                <div class="p-3 rounded-3" style="background: var(--hub-bg); border: 1px dashed var(--hub-border);">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <label class="form-label fw-semibold mb-0">
                                            <i class="bi bi-film text-info me-1"></i> Prévia do Projeto (GIF animado ou Imagem)
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(inputModel.ImagemUrl))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="RemoverMidiaProjeto">
                                                <i class="bi bi-trash me-1"></i>Remover prévia
                                            </button>
                                        }
                                    </div>

                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-7">
                                            <InputFile OnChange="CarregarMidiaProjetoAsync"
                                                       accept=".gif,.webp,.png,.jpg,.jpeg"
                                                       class="form-control form-control-sm mb-2"
                                                       disabled="@lendoMidia" />

                                            @if (EhUploadLocalOuBase64(inputModel.ImagemUrl))
                                            {
                                                <div class="badge bg-success bg-opacity-25 text-success border border-success p-2 w-100 text-truncate" title="@inputModel.ImagemUrl">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Salvo em @inputModel.ImagemUrl
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-link-45deg"></i></span>
                                                    <input type="url" class="form-control" @bind="inputModel.ImagemUrl" placeholder="Ou cole a URL de um GIF/imagem https://..." />
                                                </div>
                                            }

                                            <small class="texto-suave d-block mt-1" style="font-size: 0.75rem;">
                                                Envie um <strong>.gif</strong> (prévia animada), <strong>.webp</strong>, <strong>.png</strong> ou <strong>.jpg</strong> (máx. 10 MB). Salvo em <code>/uploads/projetos/</code>.
                                            </small>

                                            @if (lendoMidia)
                                            {
                                                <div class="mt-2 small text-info d-flex align-items-center gap-2">
                                                    <span class="spinner-border spinner-border-sm"></span> Salvando GIF / imagem no servidor...
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(erroMidia))
                                            {
                                                <div class="mt-2 small text-warning">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>@erroMidia
                                                </div>
                                            }
                                        </div>

                                        <div class="col-md-5 text-center">
                                            @if (!string.IsNullOrWhiteSpace(inputModel.ImagemUrl))
                                            {
                                                <img src="@inputModel.ImagemUrl" alt="Prévia do projeto"
                                                     class="img-fluid rounded-3 border border-info"
                                                     style="max-height: 130px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-3 bg-secondary bg-opacity-10 border border-secondary d-flex flex-column align-items-center justify-content-center p-3 texto-suave"
                                                     style="height: 110px;">
                                                    <i class="bi bi-code-slash fs-3 mb-1"></i>
                                                    <small>Sem prévia (ícone padrão)</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Status</label>
                                <InputSelect class="form-select" @bind-Value="inputModel.Status">
                                    <option value="@StatusProjeto.EmAndamento">Em Andamento</option>
                                    <option value="@StatusProjeto.Concluido">Concluído</option>
                                    <option value="@StatusProjeto.Planejado">Planejado</option>
                                    <option value="@StatusProjeto.Pausado">Pausado</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Data de Início</label>
                                <InputDate class="form-control" @bind-Value="inputModel.DataInicio" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Data de Término</label>
                                <InputDate class="form-control" @bind-Value="inputModel.DataFim" />
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox class="form-check-input" id="checkDestaque" @bind-Value="inputModel.Destaque" />
                                    <label class="form-check-label fw-semibold" for="checkDestaque">Exibir em destaque na página inicial</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold mb-2">Tecnologias Utilizadas</label>
                                <div class="d-flex flex-wrap gap-2 p-3 rounded-3" style="background: var(--hub-bg); border: 1px solid var(--hub-border);">
                                    @foreach (var tec in todasTecnologias)
                                    {
                                        var selecionada = inputModel.TecnologiaIds.Contains(tec.Id);
                                        <button type="button" class="btn btn-sm @(selecionada ? "btn-primary" : "btn-outline-secondary")"
                                                @onclick="() => AlternarTecnologia(tec.Id)">
                                            @tec.Nome
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer px-0 pb-0 mt-4">
                            <button type="button" class="btn btn-hub-outline" @onclick="FecharModal">Cancelar</button>
                            <button type="submit" class="btn btn-hub" disabled="@(salvando || lendoMidia)">
                                @if (salvando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Salvar Projeto
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL DE CONFIRMAÇÃO DE EXCLUSÃO -->
@if (projetoParaExcluir is not null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-danger">
                    <h5 class="modal-title text-danger fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Excluir Projeto</h5>
                    <button type="button" class="btn-close" @onclick="() => projetoParaExcluir = null"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza de que deseja excluir permanentemente o projeto <strong>@projetoParaExcluir.Titulo</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-hub-outline" @onclick="() => projetoParaExcluir = null">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusaoFinalAsync">Confirmar Exclusão</button>
                </div>
            </div>
        </div>
    </div>
}

<AdminLoginModal @bind-Exibir="exibirLoginModal" />

@code {
    private const long TamanhoMaximoMidiaBytes = 10 * 1024 * 1024; // 10 MB para suportar GIFs animados

    private bool carregando = true;
    private bool salvando = false;
    private bool lendoMidia = false;
    private string? erroMidia;
    private bool exibirModal = false;
    private bool exibirLoginModal = false;
    private string termoBusca = string.Empty;

    private string? mensagemAlerta;
    private string tipoAlerta = "success";

    private IReadOnlyList<ProjetoResumoDto> projetos = [];
    private IReadOnlyList<TecnologiaDto> todasTecnologias = [];

    private int? projetoEdicaoId;
    private ProjetoInputDto inputModel = new();
    private ProjetoResumoDto? projetoParaExcluir;

    private IEnumerable<ProjetoResumoDto> ProjetosFiltrados =>
        string.IsNullOrWhiteSpace(termoBusca)
            ? projetos
            : projetos.Where(p =>
                p.Titulo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                p.Resumo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                p.Tecnologias.Any(t => t.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        AdminState.OnChange += HandleAdminStateChanged;
        await CarregarDadosAsync();
    }

    private void HandleAdminStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AdminState.OnChange -= HandleAdminStateChanged;
    }

    private static bool EhUploadLocalOuBase64(string? valor) =>
        !string.IsNullOrWhiteSpace(valor) &&
        (valor.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase) ||
         valor.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase));

    private void RemoverMidiaProjeto()
    {
        Api.RemoverArquivoLocalSeExistir(inputModel.ImagemUrl);
        inputModel.ImagemUrl = null;
        erroMidia = null;
    }

    private async Task CarregarMidiaProjetoAsync(InputFileChangeEventArgs e)
    {
        var arquivo = e.File;
        if (arquivo is null) return;

        erroMidia = null;
        if (arquivo.Size > TamanhoMaximoMidiaBytes)
        {
            erroMidia = "O arquivo excede o limite de 10 MB. Tente otimizar o GIF ou usar um arquivo menor.";
            return;
        }

        try
        {
            lendoMidia = true;
            await using var stream = arquivo.OpenReadStream(TamanhoMaximoMidiaBytes);
            inputModel.ImagemUrl = await Api.SalvarUploadMidiaAsync(stream, arquivo.Name, "projetos", inputModel.ImagemUrl);
        }
        catch (Exception ex)
        {
            erroMidia = $"Falha ao salvar o arquivo: {ex.Message}";
        }
        finally
        {
            lendoMidia = false;
        }
    }

    private async Task CarregarDadosAsync()
    {
        try
        {
            carregando = true;
            var tProjetos = Api.ListarProjetosAsync();
            var tTecnologias = Api.ListarTecnologiasAsync();

            await Task.WhenAll(tProjetos, tTecnologias);

            projetos = await tProjetos;
            todasTecnologias = await tTecnologias;
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Erro ao carregar dados: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            carregando = false;
        }
    }

    private void TentarCriarProjeto()
    {
        if (!AdminState.EstaAutenticado)
        {
            exibirLoginModal = true;
            return;
        }

        erroMidia = null;
        projetoEdicaoId = null;
        inputModel = new ProjetoInputDto
        {
            Status = StatusProjeto.EmAndamento,
            DataInicio = DateOnly.FromDateTime(DateTime.Today),
            Destaque = true,
            TecnologiaIds = []
        };
        exibirModal = true;
    }

    private async Task TentarEditar(int id)
    {
        if (!AdminState.EstaAutenticado)
        {
            exibirLoginModal = true;
            return;
        }

        try
        {
            var detalhe = await Api.ObterProjetoPorIdAsync(id);
            if (detalhe is null) return;

            erroMidia = null;
            projetoEdicaoId = id;
            inputModel = new ProjetoInputDto
            {
                Titulo = detalhe.Titulo,
                Slug = detalhe.Slug,
                Resumo = detalhe.Resumo,
                Descricao = detalhe.Descricao,
                UrlRepositorio = detalhe.UrlRepositorio,
                UrlDemo = detalhe.UrlDemo,
                ImagemUrl = detalhe.ImagemUrl,
                Status = detalhe.Status,
                Destaque = detalhe.Destaque,
                DataInicio = detalhe.DataInicio,
                DataFim = detalhe.DataFim,
                TecnologiaIds = detalhe.Tecnologias.Select(t => t.Id).ToList()
            };
            exibirModal = true;
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Erro ao carregar detalhes: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private void TentarExcluir(ProjetoResumoDto p)
    {
        if (!AdminState.EstaAutenticado)
        {
            exibirLoginModal = true;
            return;
        }

        projetoParaExcluir = p;
    }

    private void AlternarTecnologia(int id)
    {
        if (inputModel.TecnologiaIds.Contains(id))
            inputModel.TecnologiaIds.Remove(id);
        else
            inputModel.TecnologiaIds.Add(id);
    }

    private async Task SalvarProjetoAsync()
    {
        try
        {
            salvando = true;
            if (projetoEdicaoId.HasValue)
            {
                await Api.AtualizarProjetoAsync(projetoEdicaoId.Value, inputModel);
                mensagemAlerta = "Projeto atualizado com sucesso!";
            }
            else
            {
                await Api.CriarProjetoAsync(inputModel);
                mensagemAlerta = "Projeto cadastrado com sucesso!";
            }

            tipoAlerta = "success";
            exibirModal = false;
            await CarregarDadosAsync();
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Falha ao salvar: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task ConfirmarExclusaoFinalAsync()
    {
        if (projetoParaExcluir is null) return;

        try
        {
            await Api.RemoverProjetoAsync(projetoParaExcluir.Id);
            mensagemAlerta = $"Projeto '{projetoParaExcluir.Titulo}' excluído com sucesso!";
            tipoAlerta = "success";
            projetoParaExcluir = null;
            await CarregarDadosAsync();
        }
        catch (Exception ex)
        {
            mensagemAlerta = $"Erro ao excluir: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private void FecharModal() => exibirModal = false;

    private string ObterCssStatus(StatusProjeto status) => status switch
    {
        StatusProjeto.Concluido => "status-concluido",
        StatusProjeto.EmAndamento => "status-andamento",
        StatusProjeto.Pausado => "status-pausado",
        _ => "status-planejado"
    };
}
