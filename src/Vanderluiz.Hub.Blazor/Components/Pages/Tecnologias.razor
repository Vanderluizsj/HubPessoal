@page "/tecnologias"
@inject HubApiClient Api

<PageTitle>Tecnologias · Hub Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Tecnologias e Ferramentas</h1>
        <p class="texto-suave mb-0">Tecnologias cadastradas na base e associadas aos projetos.</p>
    </div>
</div>

@if (carregando)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando tecnologias...</span>
        </div>
    </div>
}
else
{
    var grupos = tecnologias.GroupBy(t => t.Categoria).OrderBy(g => g.Key);

    @foreach (var grupo in grupos)
    {
        <h2 class="h5 texto-mono text-uppercase mt-4 mb-3 text-info">@grupo.Key</h2>

        <div class="row g-3 mb-4">
            @foreach (var tec in grupo)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="hub-card p-3 d-flex align-items-center gap-3">
                        <i class="@(tec.IconeClasse ?? "bi bi-code-slash") fs-2 text-white-50" style="width: 36px; text-align: center;"></i>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-bold text-truncate">@tec.Nome</div>
                            <small class="texto-suave d-block">Nível: @tec.Nivel</small>
                            <small class="text-info">@tec.QuantidadeProjetos projeto(s)</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private bool carregando = true;
    private IReadOnlyList<TecnologiaDto> tecnologias = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tecnologias = await Api.ListarTecnologiasAsync();
        }
        finally
        {
            carregando = false;
        }
    }
}

