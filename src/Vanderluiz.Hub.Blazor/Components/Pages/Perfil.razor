@page "/perfil"
@inject HubApiClient Api
@inject AdminStateService AdminState
@using Vanderluiz.Hub.Blazor.Components.Shared

<PageTitle>Perfil & Contato · Hub Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Perfil e Informações de Contato</h1>
        <p class="texto-suave mb-0">Gerencie seus canais de contato, links sociais e dados biográficos exibidos no portfólio.</p>
    </div>
</div>

@if (!AdminState.EstaAutenticado)
{
    <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <i class="bi bi-info-circle me-1"></i>
            Você está no <strong>Modo Leitura (Portfólio)</strong>. Para atualizar seus dados biográficos e canais de contato, ative o acesso de Administrador.
        </div>
        <button class="btn btn-sm btn-outline-info" @onclick="() => exibirLoginModal = true">Ativar Admin</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensagemAlerta))
{
    <div class="alert alert-@(tipoAlerta) alert-dismissible fade show" role="alert">
        @mensagemAlerta
        <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
    </div>
}

@if (carregando)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando perfil...</span>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- FORMULÁRIO DE EDIÇÃO -->
        <div class="col-lg-8">
            <div class="hub-card p-4">
                <h2 class="h5 fw-bold mb-3 text-white"><i class="bi bi-person-gear text-info me-2"></i>Editar Informações</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-white-50">Nome Completo *</label>
                        <input type="text" class="form-control" @bind="input.Nome" placeholder="Ex.: Vanderluiz" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-white-50">Título / Cargo Principal *</label>
                        <input type="text" class="form-control" @bind="input.Titulo" placeholder="Ex.: Desenvolvedor .NET" />
                    </div>

                    <div class="col-12">
                        <label class="form-label small text-white-50">Bio / Apresentação *</label>
                        <textarea class="form-control" rows="4" @bind="input.Bio" placeholder="Breve resumo sobre você, seu foco e objetivos..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-white-50">Localização</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-geo-alt"></i></span>
                            <input type="text" class="form-control" @bind="input.Localizacao" placeholder="Ex.: São Paulo, SP · Brasil" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-white-50">E-mail de Contato</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control" @bind="input.Email" placeholder="Ex.: contato@seuemail.com" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-white-50">URL do GitHub</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-github"></i></span>
                            <input type="url" class="form-control" @bind="input.GitHub" placeholder="https://github.com/seu-usuario" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-white-50">URL do LinkedIn</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-linkedin"></i></span>
                            <input type="url" class="form-control" @bind="input.LinkedIn" placeholder="https://linkedin.com/in/seu-usuario" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-white-50">Telefone / WhatsApp</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-telephone"></i></span>
                            <input type="text" class="form-control" @bind="input.Telefone" placeholder="+55 (11) 99999-9999" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-white-50">URL da Foto de Perfil</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-image"></i></span>
                            <input type="url" class="form-control" @bind="input.FotoUrl" placeholder="https://exemplo.com/sua-foto.jpg" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-end">
                    <button class="btn btn-hub px-4" disabled="@salvando" @onclick="SalvarPerfil">
                        @if (salvando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-check-lg me-1"></i> Salvar Perfil & Contato
                    </button>
                </div>
            </div>
        </div>

        <!-- PREVIEW DO CARTÃO DE CONTATO -->
        <div class="col-lg-4">
            <div class="hub-card p-4 h-100">
                <h3 class="h6 fw-bold text-white-50 text-uppercase mb-3">Prévia do Contato</h3>

                <div class="text-center p-3 mb-3 border border-secondary rounded-3 bg-black bg-opacity-25">
                    @if (!string.IsNullOrWhiteSpace(input.FotoUrl))
                    {
                        <img src="@input.FotoUrl" class="rounded-circle mb-2" style="width: 80px; height: 80px; object-fit: cover;" alt="Foto" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary bg-opacity-25 d-inline-flex align-items-center justify-content-center mb-2" style="width: 80px; height: 80px;">
                            <i class="bi bi-person text-info fs-1"></i>
                        </div>
                    }
                    <h4 class="h5 fw-bold mb-0 text-white">@(string.IsNullOrWhiteSpace(input.Nome) ? "Seu Nome" : input.Nome)</h4>
                    <small class="text-info">@(string.IsNullOrWhiteSpace(input.Titulo) ? "Seu Título" : input.Titulo)</small>
                    <p class="small texto-suave mt-2 mb-0">@(string.IsNullOrWhiteSpace(input.Bio) ? "Sua descrição biográfica aparecerá aqui." : input.Bio)</p>
                </div>

                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-black bg-opacity-25">
                        <i class="bi bi-envelope-fill text-info"></i>
                        <span class="text-truncate">@(string.IsNullOrWhiteSpace(input.Email) ? "E-mail não informado" : input.Email)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-black bg-opacity-25">
                        <i class="bi bi-linkedin text-primary"></i>
                        <span class="text-truncate">@(string.IsNullOrWhiteSpace(input.LinkedIn) ? "LinkedIn não informado" : input.LinkedIn)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-black bg-opacity-25">
                        <i class="bi bi-github text-white"></i>
                        <span class="text-truncate">@(string.IsNullOrWhiteSpace(input.GitHub) ? "GitHub não informado" : input.GitHub)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(input.Telefone))
                    {
                        <div class="d-flex align-items-center gap-2 p-2 rounded bg-black bg-opacity-25">
                            <i class="bi bi-telephone-fill text-success"></i>
                            <span class="text-truncate">@input.Telefone</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<AdminLoginModal Exibir="@exibirLoginModal"
                 AoAutenticar="AoAutenticarAdmin"
                 AoCancelar="() => exibirLoginModal = false" />

@code {
    private bool carregando = true;
    private bool salvando = false;
    private string? mensagemAlerta;
    private string tipoAlerta = "success";
    private bool exibirLoginModal = false;

    private PerfilInputDto input = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarPerfilAsync();
    }

    private async Task CarregarPerfilAsync()
    {
        try
        {
            carregando = true;
            var perfil = await Api.ObterPerfilAsync();
            if (perfil is not null)
            {
                input = new PerfilInputDto
                {
                    Nome = perfil.Nome,
                    Titulo = perfil.Titulo,
                    Bio = perfil.Bio,
                    Localizacao = perfil.Localizacao,
                    Email = perfil.Email,
                    GitHub = perfil.GitHub,
                    LinkedIn = perfil.LinkedIn,
                    FotoUrl = perfil.FotoUrl,
                    Telefone = perfil.Telefone
                };
            }
        }
        catch (Exception ex)
        {
            ExibirAlerta($"Erro ao carregar perfil: {ex.Message}", "danger");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task SalvarPerfil()
    {
        if (!AdminState.EstaAutenticado)
        {
            exibirLoginModal = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(input.Nome) || string.IsNullOrWhiteSpace(input.Titulo))
        {
            ExibirAlerta("Nome e Título são obrigatórios.", "warning");
            return;
        }

        try
        {
            salvando = true;
            await Api.AtualizarPerfilAsync(input);
            ExibirAlerta("Perfil e contatos atualizados com sucesso!");
        }
        catch (Exception ex)
        {
            ExibirAlerta($"Falha ao atualizar perfil: {ex.Message}", "danger");
        }
        finally
        {
            salvando = false;
        }
    }

    private void AoAutenticarAdmin()
    {
        exibirLoginModal = false;
        ExibirAlerta("Acesso de Administrador confirmado com sucesso!");
    }

    private void ExibirAlerta(string mensagem, string tipo = "success")
    {
        mensagemAlerta = mensagem;
        tipoAlerta = tipo;
    }
}

