@inject AdminStateService AdminState
@inject HubApiClient Api

@if (Exibir)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.75); z-index: 1055;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom border-dark-subtle">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-info"></i> Acesso Administrativo
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharAsync" disabled="@validando"></button>
                </div>
                <div class="modal-body">
                    <p class="texto-suave small mb-3">
                        Este painel está em modo de visualização pública para demonstração de portfólio.
                        Para realizar operações de inclusão, alteração ou exclusão, insira sua chave de administrador.
                    </p>

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger py-2 small mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <div>@mensagemErro</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chave de Acesso</label>
                        <input type="password" class="form-control" placeholder="Digite sua chave de admin..."
                               @bind="chaveDigitada" @onkeydown="HandleKeyDownAsync" disabled="@validando" autofocus />
                    </div>
                </div>
                <div class="modal-footer border-top border-dark-subtle">
                    <button type="button" class="btn btn-hub-outline btn-sm" @onclick="FecharAsync" disabled="@validando">Cancelar</button>
                    <button type="button" class="btn btn-hub btn-sm d-flex align-items-center gap-1" @onclick="TentarAutenticarAsync" disabled="@(validando || string.IsNullOrWhiteSpace(chaveDigitada))">
                        @if (validando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        <span>Entrar</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Exibir { get; set; }
    [Parameter] public EventCallback<bool> ExibirChanged { get; set; }

    private string chaveDigitada = string.Empty;
    private string? mensagemErro;
    private bool validando = false;

    protected override void OnParametersSet()
    {
        if (Exibir)
        {
            chaveDigitada = string.Empty;
            mensagemErro = null;
            validando = false;
        }
    }

    private async Task TentarAutenticarAsync()
    {
        if (string.IsNullOrWhiteSpace(chaveDigitada))
        {
            mensagemErro = "Por favor, digite a chave de acesso.";
            return;
        }

        try
        {
            validando = true;
            mensagemErro = null;

            var valido = await Api.ValidarLoginAsync(chaveDigitada);
            if (valido)
            {
                AdminState.DefinirAutenticado(chaveDigitada);
                await FecharAsync();
            }
            else
            {
                mensagemErro = "Chave de acesso incorreta. Tente novamente.";
                chaveDigitada = string.Empty;
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao validar com o servidor: {ex.Message}";
        }
        finally
        {
            validando = false;
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !validando && !string.IsNullOrWhiteSpace(chaveDigitada))
        {
            await TentarAutenticarAsync();
        }
    }

    private async Task FecharAsync()
    {
        Exibir = false;
        chaveDigitada = string.Empty;
        mensagemErro = null;
        await ExibirChanged.InvokeAsync(false);
    }
}
