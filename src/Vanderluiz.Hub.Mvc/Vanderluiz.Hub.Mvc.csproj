<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Vanderluiz.Hub.Application\Vanderluiz.Hub.Application.csproj" />
    <ProjectReference Include="..\Vanderluiz.Hub.Infrastructure\Vanderluiz.Hub.Infrastructure.csproj" />
    <ProjectReference Include="..\Vanderluiz.Hub.Api\Vanderluiz.Hub.Api.csproj" />
    <ProjectReference Include="..\Vanderluiz.Hub.Blazor\Vanderluiz.Hub.Blazor.csproj" />
  </ItemGroup>

  <!--
    O projeto Blazor (Web SDK) expõe seu wwwroot na raiz "/" do host unificado.
    Como ele já contém o Bootstrap 5.3.3 em "lib/bootstrap", a cópia idêntica do MVC
    gera conflito de Static Web Assets (mesmo caminho de destino). Removemos a cópia do MVC
    e passamos a usar a do Blazor, que é servida no mesmo caminho (~/lib/bootstrap/...).
  -->
  <ItemGroup>
    <Content Remove="wwwroot\lib\bootstrap\**" />
    <None Include="wwwroot\lib\bootstrap\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

</Project>
