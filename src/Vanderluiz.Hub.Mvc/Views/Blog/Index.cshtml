@model IReadOnlyList<PostResumoDto>
@{
    ViewData["Title"] = "Blog";
}
<section class="container secao">
    <h1 class="secao-titulo mb-2"><span class="secao-numero">#</span> Blog</h1>
    <p class="texto-suave mb-5">Anotações, estudos e aprendizados.</p>

    @if (Model.Count == 0)
    {
        <p class="texto-suave">Nenhum post publicado ainda.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var post in Model)
            {
                <article class="hub-card p-4 position-relative">
                    <p class="texto-mono small mb-2">@post.PublicadoEm?.ToLocalTime().ToString("dd 'de' MMMM 'de' yyyy")</p>
                    <h2 class="h4"><a class="stretched-link link-titulo" href="/blog/@post.Slug">@post.Titulo</a></h2>
                    <p class="texto-suave mb-0">@post.Resumo</p>
                </article>
            }
        </div>
    }
</section>

