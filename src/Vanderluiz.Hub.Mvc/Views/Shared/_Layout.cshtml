@{
    var perfil = await PerfilProvider.GetPerfilAsync();
    var path = Context.Request.Path.Value ?? "/";
    string Ativo(string prefixo) =>
        (prefixo == "/" ? path == "/" : path.StartsWith(prefixo, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · {perfil.Nome}" : $"{perfil.Nome} · {perfil.Titulo}")</title>
    <meta name="description" content="@(ViewData["Description"] ?? perfil.Bio)" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vanderluiz.Hub.Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top hub-navbar">
            <div class="container">
                <a class="navbar-brand hub-brand" href="/">
                    <span class="brand-bracket">&lt;</span>@perfil.Nome<span class="brand-bracket"> /&gt;</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hubNav"
                        aria-controls="hubNav" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="hubNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link @Ativo("/")" href="/">Início</a></li>
                        <li class="nav-item"><a class="nav-link @Ativo("/sobre")" href="/sobre">Sobre</a></li>
                        <li class="nav-item"><a class="nav-link @Ativo("/trajetoria")" href="/trajetoria">Trajetória</a></li>
                        <li class="nav-item"><a class="nav-link @Ativo("/projetos")" href="/projetos">Projetos</a></li>
                        <li class="nav-item"><a class="nav-link @Ativo("/tecnologias")" href="/tecnologias">Tecnologias</a></li>
                        <li class="nav-item"><a class="nav-link @Ativo("/blog")" href="/blog">Blog</a></li>
                        <li class="nav-item"><a class="nav-link @Ativo("/contato")" href="/contato">Contato</a></li>

                        <li class="nav-item ms-lg-3 my-2 my-lg-0 border-start border-secondary ps-lg-3 d-flex gap-2">
                            <a class="btn btn-outline-info btn-sm d-flex align-items-center gap-1"
                                href="/admin" title="Abrir Painel Administrativo em Blazor">
                                <i class="bi bi-shield-lock"></i>
                                <span>Admin</span>
                            </a>
                            <a class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                                href="/scalar/v1" target="_blank" rel="noopener" title="Documentação Interativa da API (Scalar)">
                                <i class="bi bi-file-earmark-code"></i>
                                <span>API</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="hub-main">
        @RenderBody()
    </main>

    <footer class="hub-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year @perfil.Nome · Feito com ASP.NET Core</span>
                <span class="text-white-50">·</span>
                <a href="/admin" class="small text-decoration-none texto-destaque">Gestão (Admin)</a>
                <span class="text-white-50">·</span>
                <a href="/scalar/v1" target="_blank" class="small text-decoration-none texto-destaque">API Docs</a>
            </div>
            <partial name="_RedesSociais" />
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
