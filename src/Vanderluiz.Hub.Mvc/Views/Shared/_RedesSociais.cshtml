@{
    var p = await PerfilProvider.GetPerfilAsync();
}
<div class="hub-social">
    @if (!string.IsNullOrWhiteSpace(p.GitHub))
    {
        <a href="@p.GitHub" target="_blank" rel="noopener" aria-label="GitHub"><i class="bi bi-github"></i></a>
    }
    @if (!string.IsNullOrWhiteSpace(p.LinkedIn))
    {
        <a href="@p.LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
    }
    @if (!string.IsNullOrWhiteSpace(p.Email))
    {
        <a href="mailto:@p.Email" aria-label="E-mail"><i class="bi bi-envelope-fill"></i></a>
    }
</div>

